# Copie para .env.local. Sem as duas primeiras o sistema roda em MODO DEMONSTRAÇÃO.
NEXT_PUBLIC_SUPABASE_URL=
# Chave "anon" ou "publishable" (pública por desenho; a segurança vem do RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço do site (usado no aviso que o proprietário envia ao inquilino).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SÓ no servidor. NUNCA com prefixo NEXT_PUBLIC_. Habilita liberar acesso do inquilino. (Supabase > Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=
